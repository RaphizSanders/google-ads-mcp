GOOGLE_ADS_CREDENTIALS_PATH=./google_ads_token.json
# Hosted alternative (write-only secret): GOOGLE_ADS_CREDENTIALS_JSON={...}
# Service account (alternativa ao OAuth de usuario): GOOGLE_ADS_SERVICE_ACCOUNT_KEY_PATH=./sa.json
# GOOGLE_ADS_DEVELOPER_TOKEN=   -> descontinuado em 09/09/2026 (ignorado pela API); pode omitir
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9237732698
# GOOGLE_ADS_API_VERSION=v25
# MCP_API_KEY=
# MCP_ALLOWED_HOSTS=google-ads-mcp.railway.internal,localhost,127.0.0.1
# ALLOWED_CUSTOMER_IDS=*   -> todo o MCC do login (agencia/gestor)
# ALLOWED_CUSTOMER_IDS=1234567890,0987654321  -> um cliente por servico
# ALLOWED_CUSTOMER_IDS=
# GOOGLE_ADS_READ_ONLY=true
# GOOGLE_ADS_DRY_RUN=true   -> toda escrita vai com validateOnly (nada e gravado)
# GOOGLE_ADS_TOOL_GROUPS=core,negatives,diagnostics   -> publica so esses grupos (padrao: todos)
# PORT=

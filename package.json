{
  "name": "google-ads-mcp",
  "version": "1.1.0",
  "description": "MCP server para gerenciar Google Ads (Search, Shopping, PMax, Display). Local (stdio) e remoto (HTTP/SSE).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "dev:local": "tsx src/index.ts",
    "dev:http": "PORT=3333 node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:read-only": "tsx --test tests/read-only.test.ts",
    "prepare": "npm run build",
    "test:allowlist": "tsx --test tests/allowlist.test.ts",
    "test:conversion-enums": "tsx --test tests/conversion-enums.test.ts",
    "test:campaign-images": "tsx --test tests/campaign-image-assets.test.ts",
    "test:ai-max": "tsx --test tests/ai-max.test.ts",
    "test:operations": "tsx --test tests/operations.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "google",
    "ads",
    "google-ads",
    "marketing",
    "gaql"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
